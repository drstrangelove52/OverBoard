<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OverBoardAgent.AppView">
    <ScrollViewer>
        <StackPanel Spacing="10" Margin="28" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Name="AppHeader" FontSize="20" FontWeight="SemiBold" />

            <Border Classes="card" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="LanguageLabel" FontSize="12" Opacity="0.7" />
                    <ComboBox x:Name="LanguageBox" Width="220" />
                    <CheckBox x:Name="AutostartBox" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="UpdateHeader" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <CheckBox x:Name="UpdateBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckNowButton" />
                        <Button x:Name="InstallUpdateButton" Classes="accent" IsVisible="False" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" IsVisible="False" />
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateNotes" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxHeight="160" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AboutHeader" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock x:Name="FoldersText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenDataButton" />
                        <Button x:Name="OpenLogButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
