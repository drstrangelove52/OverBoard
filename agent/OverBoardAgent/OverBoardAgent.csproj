<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OverBoardAgent</AssemblyName>
    <RootNamespace>OverBoardAgent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Die passende Firmware kommt mit dem Programm (vom Release-Ablauf nach firmware\ gelegt). -->
  <ItemGroup>
    <Content Include="firmware\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('firmware')" />
  </ItemGroup>
  <!-- Schlanke Veröffentlichung: nur die .NET-Teile, die gebraucht werden (eigene Programmteile bleiben unangetastet), ohne Debug-Dateien. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <Target Name="DropPdbFromPublish" AfterTargets="Publish" Condition="'$(PublishTrimmed)' == 'true'">
    <ItemGroup><PdbToDelete Include="$(PublishDir)*.pdb" /></ItemGroup>
    <Delete Files="@(PdbToDelete)" />
  </Target>
</Project>
