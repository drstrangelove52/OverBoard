<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OverBoardAgent"
             x:Class="OverBoardAgent.ActionsView">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock x:Name="ActionsLabel" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Grid.Row="1" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,8,0,0">
            <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ActionList" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ActionRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" Width="150">
                <Button x:Name="NewButton" HorizontalAlignment="Stretch" Classes="accent" />
                <Button x:Name="EditButton" HorizontalAlignment="Stretch" />
                <Button x:Name="TestButton" HorizontalAlignment="Stretch" />
                <Button x:Name="DeleteButton" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
