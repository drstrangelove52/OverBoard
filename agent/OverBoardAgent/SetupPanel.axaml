<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OverBoardAgent.SetupPanel">
    <StackPanel Spacing="6">
        <TextBlock x:Name="SetupHint" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />

        <TextBlock x:Name="WifiLabel" FontWeight="SemiBold" Margin="0,10,0,0" />
        <TextBlock x:Name="WifiSsidLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="WifiSsidBox" />
        <TextBlock x:Name="WifiPassLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="WifiPassBox" PasswordChar="●" />

        <TextBlock x:Name="HaLabel" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock x:Name="HaUrlLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="HaUrlBox" />
        <TextBlock x:Name="HaTokenLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="HaTokenBox" PasswordChar="●" />
        <TextBlock x:Name="HaHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

        <TextBlock x:Name="MqttLabel" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock x:Name="MqttHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        <TextBlock x:Name="MqttHostLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="MqttHostBox" />
        <TextBlock x:Name="MqttUserLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="MqttUserBox" />
        <TextBlock x:Name="MqttPassLabel" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="MqttPassBox" PasswordChar="●" />

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Classes="accent" />
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
