<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OverBoardAgent"
             x:Class="OverBoardAgent.RadioView">
    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <TextBlock x:Name="RadioLabel" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Grid.Row="1" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
        <Border Grid.Row="2" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080" Margin="0,6,0,0">
            <StackPanel Spacing="2">
                <TextBlock x:Name="NowStation" FontWeight="SemiBold" />
                <TextBlock x:Name="NowTitle" FontSize="13" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock x:Name="NowError" FontSize="12" Foreground="#E5484D" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,8,0,0">
            <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="8">
                <Grid>
                    <ListBox x:Name="StationList" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:StationRow">
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" Width="170">
                <Button x:Name="PlayButton" HorizontalAlignment="Stretch" Classes="accent" />
                <Button x:Name="SearchButton" HorizontalAlignment="Stretch" />
                <Button x:Name="ManualButton" HorizontalAlignment="Stretch" />
                <Button x:Name="EditButton" HorizontalAlignment="Stretch" />
                <Button x:Name="UpButton" HorizontalAlignment="Stretch" />
                <Button x:Name="DownButton" HorizontalAlignment="Stretch" />
                <Button x:Name="DeleteButton" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
