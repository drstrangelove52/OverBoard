<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OverBoardAgent.StartView">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="StartHeader" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="StartSub" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />

            <WrapPanel x:Name="StatusPanel" Orientation="Horizontal" />

            <TextBlock x:Name="StepsHeader" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
            <Border BorderThickness="1" BorderBrush="#30808080" CornerRadius="8">
                <StackPanel x:Name="StepsPanel" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
