<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OverBoardAgent"
        x:Class="OverBoardAgent.Editor.EditorWindow"
        Width="1400" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/tray.png">
    <Grid ColumnDefinitions="210,*">

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#14808080" BorderThickness="0,0,1,0" BorderBrush="#30808080">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="AppTitle" Margin="20,18,20,14" FontSize="18" FontWeight="SemiBold" />
                <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" Margin="8,0" />
                <StackPanel Grid.Row="2" Margin="20,12,20,18" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="NavDot" Width="10" Height="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavConn" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <Grid Grid.Row="0">

                <!-- Seite Display: der eigentliche Editor -->
                <Grid x:Name="PageDisplay" RowDefinitions="Auto,Auto,*">

                    <!-- Werkzeugleiste: Rückgängig, Live-Zustand, Gestalten/Vorführen, Menü -->
                    <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#30808080">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="UndoButton" />
                                <Button x:Name="RedoButton" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Ellipse x:Name="LiveDot" Width="10" Height="10" VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="SendButton" Classes="accent" />
                            </StackPanel>
                            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#50808080" CornerRadius="8" ClipToBounds="True">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ModeDesignBtn" CornerRadius="0" BorderThickness="0" Padding="14,6" />
                                    <ToggleButton x:Name="ModeDemoBtn" CornerRadius="0" BorderThickness="0" Padding="14,6" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MoreButton" Grid.Column="3" Content="⋯" FontSize="18" Padding="12,2">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="8" MinWidth="260">
                                            <CheckBox x:Name="LiveBox" IsChecked="True" />
                                            <CheckBox x:Name="RealValuesBox" IsChecked="True" />
                                            <CheckBox x:Name="DemoBox" IsVisible="False" />
                                            <Border Height="1" Background="#30808080" Margin="0,4" />
                                            <Button x:Name="LoadButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                            <Button x:Name="OpenFileButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                            <Button x:Name="SaveFileButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                            <Button x:Name="ResetButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                            <Button x:Name="JsonButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Seiten als Reiter -->
                    <Border Grid.Row="1" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="#30808080">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ListBox x:Name="PageList" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="AddPageButton" />
                                <Button x:Name="TemplateButton" />
                                <Button x:Name="PageSettingsButton">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="6" Width="280">
                                                <TextBlock x:Name="PagesLabel" FontWeight="SemiBold" />
                                                <TextBlock x:Name="PageTitleDeLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                                <TextBox x:Name="PageTitleDe" />
                                                <TextBlock x:Name="PageIconLabel" FontSize="12" Opacity="0.7" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <AutoCompleteBox x:Name="PageIcon" FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="260" />
                                                    <Button x:Name="PageIconPick" Grid.Column="1" Content="…" />
                                                </Grid>
                                                <TextBlock x:Name="PageRowsLabel" FontSize="12" Opacity="0.7" />
                                                <NumericUpDown x:Name="PageRows" Minimum="1" Maximum="6" FormatString="0" Increment="1" />
                                                <Button x:Name="DeletePageButton" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,330">

                        <!-- Mitte: das Display und darunter die Palette für neue Kacheln -->
                        <Grid Grid.Column="0" RowDefinitions="*,Auto">
                            <Border Grid.Row="0" Background="#18808080">
                                <Viewbox Stretch="Uniform" Margin="18">
                                    <ContentControl x:Name="Host" Cursor="Arrow" />
                                </Viewbox>
                            </Border>
                            <Border x:Name="PalettePanel" Grid.Row="1" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#30808080">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AddLabel" VerticalAlignment="Center" Opacity="0.7" />
                                    <Button x:Name="AddButtonButton" />
                                    <Button x:Name="AddValueButton" />
                                    <Button x:Name="AddChartButton" />
                                    <Button x:Name="AddCalendarButton" />
                                    <Button x:Name="AddRadioButton" />
                                    <Border Width="1" Background="#40808080" Margin="6,2" />
                                    <Button x:Name="PasteButton" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Rechts: Eigenschaften der gewählten Kachel -->
                        <ScrollViewer x:Name="InspectorPanel" Grid.Column="1" BorderThickness="1,0,0,0">
                            <StackPanel Margin="14" Spacing="6">
                                <TextBlock x:Name="TileHeader" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="NoTileText" TextWrapping="Wrap" Opacity="0.65" />
                                <StackPanel x:Name="TilePanel" Spacing="6">

                                    <!-- Art der Kachel -->
                                    <TextBlock x:Name="TypeLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="TypeBox" IsVisible="False" />
                                    <UniformGrid Columns="3">
                                        <ToggleButton x:Name="TypeValueBtn" HorizontalAlignment="Stretch" Margin="0,0,4,4" />
                                        <ToggleButton x:Name="TypeButtonBtn" HorizontalAlignment="Stretch" Margin="2,0,2,4" />
                                        <ToggleButton x:Name="TypeChartBtn" HorizontalAlignment="Stretch" Margin="4,0,0,4" />
                                        <ToggleButton x:Name="TypeCalBtn" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                                        <ToggleButton x:Name="TypeRadioBtn" HorizontalAlignment="Stretch" Margin="2,0,2,0" />
                                    </UniformGrid>

                                    <TextBlock x:Name="TitleDeLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                    <TextBox x:Name="TitleDe" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="90" />
                                    <TextBlock x:Name="IconLabel" FontSize="12" Opacity="0.7" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <AutoCompleteBox x:Name="IconBox" FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="260" />
                                        <TextBlock x:Name="IconPreview" Grid.Column="1" FontSize="30" VerticalAlignment="Center" />
                                        <Button x:Name="IconPickButton" Grid.Column="2" Content="…" />
                                    </Grid>

                                    <!-- Inhalt: hängt von der Art ab -->
                                    <Border Height="1" Background="#30808080" Margin="0,10,0,4" />
                                    <TextBlock x:Name="ContentLabel" FontWeight="SemiBold" />

                                    <TextBlock x:Name="TileInfoText" TextWrapping="Wrap" Opacity="0.75" />
                                    <Button x:Name="InfoGoButton" HorizontalAlignment="Left" />

                                    <TextBlock x:Name="ButtonModeLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="ButtonModeBox" IsVisible="False" />
                                    <UniformGrid x:Name="ButtonModeCards" Columns="2">
                                        <ToggleButton x:Name="ModePcBtn" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                                        <ToggleButton x:Name="ModeHaBtn" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <TextBlock x:Name="ActionLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="ActionBox" HorizontalAlignment="Stretch" />
                                    <Button x:Name="NewActionButton" HorizontalAlignment="Left" />

                                    <TextBlock x:Name="SourceKindLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="SourceKindBox" HorizontalAlignment="Stretch" />
                                    <ComboBox x:Name="PcSourceBox" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="SourceLabel" FontSize="12" Opacity="0.7" />
                                    <Grid x:Name="SourcePanelRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="SourceBox" />
                                        <Button x:Name="SourcePickButton" Grid.Column="1" Content="…" />
                                    </Grid>
                                    <TextBlock x:Name="SpanLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="SpanBox" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="FormatLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" />
                                    <StackPanel x:Name="MaxPanel" Spacing="6">
                                        <TextBlock x:Name="MaxLabel" FontSize="12" Opacity="0.7" />
                                        <NumericUpDown x:Name="MaxBox" Minimum="0" Maximum="100000" Increment="100" FormatString="0" />
                                    </StackPanel>

                                    <!-- Erweitert: Bedienung, Position, Vorschau -->
                                    <Expander x:Name="AdvancedExpander" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                            <StackPanel x:Name="VolumePanel" Spacing="6">
                                                <TextBlock x:Name="VolStepLabel" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                <NumericUpDown x:Name="VolStepBox" Minimum="1" Maximum="20" Increment="1" FormatString="0" />
                                                <TextBlock x:Name="VolRateLabel" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                <NumericUpDown x:Name="VolRateBox" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
                                                <TextBlock x:Name="VolNote" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel x:Name="ButtonPanel" Spacing="6">
                                                <TextBlock x:Name="TriggerLabel" FontSize="12" Opacity="0.7" />
                                                <ComboBox x:Name="TriggerBox" HorizontalAlignment="Stretch" />
                                                <TextBlock x:Name="TileHoldLabel" FontSize="12" Opacity="0.7" />
                                                <NumericUpDown x:Name="TileHoldBox" Minimum="0" Maximum="5000" Increment="50" FormatString="0" />
                                            </StackPanel>
                                            <CheckBox x:Name="AdvLightBox" />
                                            <TextBlock x:Name="GeometryLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                <NumericUpDown x:Name="XBox" Minimum="0" Maximum="7" FormatString="0" ShowButtonSpinner="False" />
                                                <NumericUpDown x:Name="YBox" Grid.Column="1" Minimum="0" Maximum="5" FormatString="0" ShowButtonSpinner="False" />
                                                <NumericUpDown x:Name="WBox" Grid.Column="2" Minimum="1" Maximum="8" FormatString="0" ShowButtonSpinner="False" />
                                                <NumericUpDown x:Name="HBox" Grid.Column="3" Minimum="1" Maximum="6" FormatString="0" ShowButtonSpinner="False" />
                                            </Grid>
                                            <TextBlock x:Name="GeometryHint" FontSize="11" Opacity="0.55" />
                                            <CheckBox x:Name="OnBox" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Expander>

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Button x:Name="CopyTileButton" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                                        <Button x:Name="CutTileButton" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
                                    </UniformGrid>
                                    <Button x:Name="DeleteTileButton" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Seite Start -->
                <local:StartView x:Name="StartPage" />

                <!-- Seite Inhalte: Aktionen und Radio -->
                <TabControl x:Name="PageContent" IsVisible="False">
                    <TabItem x:Name="ContentTabActions"><local:ActionsView x:Name="ActionsPage" /></TabItem>
                    <TabItem x:Name="ContentTabRadio"><local:RadioView x:Name="RadioPage" /></TabItem>
                </TabControl>

                <!-- Seite Verbindungen -->
                <local:ConnectionsView x:Name="ConnectionsPage" IsVisible="False" />

                <!-- Seite Gerät: Verbindung und Firmware, Anzeige und Ton, Energiesparen -->
                <TabControl x:Name="PageDevice" IsVisible="False">
                    <TabItem x:Name="DevTabDevice">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="28" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="ConnectionHeader" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="DeviceStatusText" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="FirmwareHeader" FontWeight="SemiBold" />
                                                            <local:FirmwarePanel x:Name="FirmwarePage" />
                                                        </StackPanel>
                                                    </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="DevTabLook">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="28" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="DisplayCardHeader" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="DisplayCardHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="LanguageLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                                            <ComboBox x:Name="LanguageBox" Width="260" />
                                                            <TextBlock x:Name="ThemeLabel" FontSize="12" Opacity="0.7" />
                                                            <ComboBox x:Name="ThemeBox" Width="260" />
                                                            <TextBlock x:Name="BrightnessLabel" FontSize="12" Opacity="0.7" />
                                                            <NumericUpDown x:Name="BrightnessBox" Minimum="1" Maximum="100" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                                            <TextBlock x:Name="HoldLabel" FontSize="12" Opacity="0.7" />
                                                            <NumericUpDown x:Name="HoldBox" Minimum="100" Maximum="5000" Increment="50" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Border>

                            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="SoundHeader" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="SoundHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                                            <CheckBox x:Name="ClickBox" Margin="0,6,0,0" />
                                                            <TextBlock x:Name="ClickVolumeLabel" FontSize="12" Opacity="0.7" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <NumericUpDown x:Name="ClickVolumeBox" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="260" />
                                                                <Button x:Name="ClickTestButton" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="SoundVolumeLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <NumericUpDown x:Name="SoundVolumeBox" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="260" />
                                                                <Button x:Name="SoundTestButton" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="DevTabPower">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="28" MaxWidth="760" HorizontalAlignment="Left">
                            <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Name="IdleHeader" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="IdleHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                                            <Border Padding="10" CornerRadius="6" Background="#18808080" Margin="0,6,0,0"><TextBlock x:Name="PowerSummary" TextWrapping="Wrap" /></Border>

                                                            <TextBlock x:Name="SaverHeader" FontWeight="SemiBold" Margin="0,12,0,0" />
                                                            <TextBlock x:Name="IdleLabel" FontSize="12" Opacity="0.7" />
                                                            <NumericUpDown x:Name="IdleBox" Minimum="0.1" Maximum="60" Increment="1" FormatString="0.##" Width="260" HorizontalAlignment="Left" />
                                                            <TextBlock x:Name="IdleBrightLabel" FontSize="12" Opacity="0.7" />
                                                            <NumericUpDown x:Name="IdleBrightBox" Minimum="1" Maximum="100" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                                            <TextBlock x:Name="IdleMoveLabel" FontSize="12" Opacity="0.7" />
                                                            <NumericUpDown x:Name="IdleMoveBox" Minimum="0.1" Maximum="60" Increment="1" FormatString="0.##" Width="260" HorizontalAlignment="Left" />
                                                            <StackPanel x:Name="IdleValuesPanel" Spacing="6" Margin="0,6,0,0" />

                                                            <Border Height="1" Background="#30808080" Margin="0,16,0,4" />

                                                            <TextBlock x:Name="PowerHeader" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="PowerHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="OffMinLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                                            <NumericUpDown x:Name="OffMinBox" Minimum="0" Maximum="1440" Increment="1" FormatString="0.##" Width="260" HorizontalAlignment="Left" />
                                                            <CheckBox x:Name="PcAwayBox" Margin="0,8,0,0" />
                                                            <TextBlock x:Name="AwayDelayLabel" FontSize="12" Opacity="0.7" Margin="28,0,0,0" />
                                                            <NumericUpDown x:Name="AwayDelayBox" Minimum="0.1" Maximum="60" Increment="1" FormatString="0.##" Width="260" HorizontalAlignment="Left" Margin="28,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Seite Programm -->
                <local:AppView x:Name="AppPage" IsVisible="False" />
            </Grid>

            <!-- Statuszeile (gilt für alle Seiten) -->
            <Border Grid.Row="1" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="#30808080">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
