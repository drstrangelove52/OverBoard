<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OverBoardAgent"
        x:Class="OverBoardAgent.Editor.EditorWindow"
        Width="1560" Height="920" MinWidth="1200" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/tray.png">
    <Grid ColumnDefinitions="210,*">

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#14808080" BorderThickness="0,0,1,0" BorderBrush="#30808080">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="AppTitle" Margin="20,18,20,14" FontSize="18" FontWeight="SemiBold" />
                <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" Margin="8,0" />
                <StackPanel Grid.Row="2" Margin="20,12,20,18" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="NavDot" Width="10" Height="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavConn" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <Grid Grid.Row="0">

                <!-- Seite Display: der eigentliche Editor -->
                <Grid x:Name="PageDisplay" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#30808080">
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="UndoButton" Margin="0,0,6,0" />
                            <Button x:Name="RedoButton" Margin="0,0,16,0" />
                            <Button x:Name="SendButton" Classes="accent" Margin="0,0,6,0" />
                            <CheckBox x:Name="LiveBox" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="RealValuesBox" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button x:Name="LoadButton" Margin="0,0,6,0" />
                            <Button x:Name="OpenFileButton" Margin="0,0,6,0" />
                            <Button x:Name="SaveFileButton" Margin="0,0,6,0" />
                            <Button x:Name="ResetButton" Margin="0,0,6,0" />
                            <Button x:Name="JsonButton" />
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="250,*,320">

                        <!-- Links: Seiten und neue Kacheln -->
                        <ScrollViewer Grid.Column="0" BorderThickness="0,0,1,0">
                            <StackPanel Margin="14" Spacing="8">
                                <TextBlock x:Name="PagesLabel" FontWeight="SemiBold" />
                                <ListBox x:Name="PageList" MaxHeight="190" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="AddPageButton" />
                                    <Button x:Name="DeletePageButton" />
                                </StackPanel>
                                <TextBlock x:Name="PageTitleDeLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                <TextBox x:Name="PageTitleDe" />
                                <TextBlock x:Name="PageIconLabel" FontSize="12" Opacity="0.7" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <AutoCompleteBox x:Name="PageIcon" FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="260" />
                                    <Button x:Name="PageIconPick" Grid.Column="1" Content="…" />
                                </Grid>
                                <TextBlock x:Name="PageRowsLabel" FontSize="12" Opacity="0.7" />
                                <NumericUpDown x:Name="PageRows" Minimum="1" Maximum="6" FormatString="0" Increment="1" />

                                <TextBlock x:Name="AddLabel" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <Button x:Name="AddValueButton" HorizontalAlignment="Stretch" />
                                <Button x:Name="AddButtonButton" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Mitte: das Display -->
                        <Border Grid.Column="1" Background="#18808080">
                            <Viewbox Stretch="Uniform" Margin="18">
                                <ContentControl x:Name="Host" Cursor="Arrow" />
                            </Viewbox>
                        </Border>

                        <!-- Rechts: Eigenschaften der gewählten Kachel -->
                        <ScrollViewer Grid.Column="2" BorderThickness="1,0,0,0">
                            <StackPanel Margin="14" Spacing="6">
                                <TextBlock x:Name="TileHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="NoTileText" TextWrapping="Wrap" Opacity="0.65" />
                                <StackPanel x:Name="TilePanel" Spacing="6">
                                    <TextBlock x:Name="TypeLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="TitleDeLabel" FontSize="12" Opacity="0.7" />
                                    <TextBox x:Name="TitleDe" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="90" />
                                    <TextBlock x:Name="IconLabel" FontSize="12" Opacity="0.7" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <AutoCompleteBox x:Name="IconBox" FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="260" />
                                        <TextBlock x:Name="IconPreview" Grid.Column="1" FontSize="30" VerticalAlignment="Center" />
                                        <Button x:Name="IconPickButton" Grid.Column="2" Content="…" />
                                    </Grid>
                                    <TextBlock x:Name="SourceLabel" FontSize="12" Opacity="0.7" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="SourceBox" />
                                        <Button x:Name="SourcePickButton" Grid.Column="1" Content="…" />
                                    </Grid>
                                    <TextBlock x:Name="FormatLabel" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" />
                                    <StackPanel x:Name="MaxPanel" Spacing="6">
                                        <TextBlock x:Name="MaxLabel" FontSize="12" Opacity="0.7" />
                                        <NumericUpDown x:Name="MaxBox" Minimum="0" Maximum="100000" Increment="100" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ButtonPanel" Spacing="6">
                                        <TextBlock x:Name="TriggerLabel" FontSize="12" Opacity="0.7" />
                                        <ComboBox x:Name="TriggerBox" HorizontalAlignment="Stretch" />
                                        <TextBlock x:Name="ActionLabel" FontSize="12" Opacity="0.7" />
                                        <ComboBox x:Name="ActionBox" HorizontalAlignment="Stretch" />
                                        <Button x:Name="NewActionButton" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="TileHoldLabel" FontSize="12" Opacity="0.7" />
                                        <NumericUpDown x:Name="TileHoldBox" Minimum="0" Maximum="5000" Increment="50" FormatString="0" />
                                    </StackPanel>
                                    <TextBlock x:Name="GeometryLabel" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                        <NumericUpDown x:Name="XBox" Minimum="0" Maximum="7" FormatString="0" ShowButtonSpinner="False" />
                                        <NumericUpDown x:Name="YBox" Grid.Column="1" Minimum="0" Maximum="5" FormatString="0" ShowButtonSpinner="False" />
                                        <NumericUpDown x:Name="WBox" Grid.Column="2" Minimum="1" Maximum="8" FormatString="0" ShowButtonSpinner="False" />
                                        <NumericUpDown x:Name="HBox" Grid.Column="3" Minimum="1" Maximum="6" FormatString="0" ShowButtonSpinner="False" />
                                    </Grid>
                                    <TextBlock x:Name="GeometryHint" FontSize="11" Opacity="0.55" />
                                    <CheckBox x:Name="OnBox" Margin="0,8,0,0" />
                                    <Button x:Name="DeleteTileButton" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Seite Aktionen -->
                <local:ActionsView x:Name="ActionsPage" IsVisible="False" />

                <!-- Seite Gerät: Verbindung, Einrichtung, Anzeige, Ruhemodus -->
                <ScrollViewer x:Name="PageDevice" IsVisible="False">
                    <StackPanel Spacing="14" Margin="28" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock x:Name="DeviceHeader" FontSize="20" FontWeight="SemiBold" />

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ConnectionHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="DeviceStatusText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="FirmwareHeader" FontWeight="SemiBold" />
                                <local:FirmwarePanel x:Name="FirmwarePage" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SetupHeader" FontWeight="SemiBold" />
                                <local:SetupPanel x:Name="SetupPage" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DisplayCardHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="DisplayCardHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                <TextBlock x:Name="LanguageLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                <ComboBox x:Name="LanguageBox" Width="260" />
                                <TextBlock x:Name="ThemeLabel" FontSize="12" Opacity="0.7" />
                                <ComboBox x:Name="ThemeBox" Width="260" />
                                <TextBlock x:Name="BrightnessLabel" FontSize="12" Opacity="0.7" />
                                <NumericUpDown x:Name="BrightnessBox" Minimum="1" Maximum="100" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                <TextBlock x:Name="HoldLabel" FontSize="12" Opacity="0.7" />
                                <NumericUpDown x:Name="HoldBox" Minimum="100" Maximum="5000" Increment="50" FormatString="0" Width="260" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SoundHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="SoundHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                                <CheckBox x:Name="ClickBox" Margin="0,6,0,0" />
                                <TextBlock x:Name="ClickVolumeLabel" FontSize="12" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumericUpDown x:Name="ClickVolumeBox" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="260" />
                                    <Button x:Name="ClickTestButton" />
                                </StackPanel>
                                <TextBlock x:Name="SoundVolumeLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumericUpDown x:Name="SoundVolumeBox" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="260" />
                                    <Button x:Name="SoundTestButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="#30808080" Background="#10808080">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="IdleHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="IdleLabel" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                                <NumericUpDown x:Name="IdleBox" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                <TextBlock x:Name="IdleBrightLabel" FontSize="12" Opacity="0.7" />
                                <NumericUpDown x:Name="IdleBrightBox" Minimum="1" Maximum="100" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                <TextBlock x:Name="IdleMoveLabel" FontSize="12" Opacity="0.7" />
                                <NumericUpDown x:Name="IdleMoveBox" Minimum="5" Maximum="3600" Increment="5" FormatString="0" Width="260" HorizontalAlignment="Left" />
                                <StackPanel x:Name="IdleValuesPanel" Spacing="6" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Seite Programm -->
                <local:AppView x:Name="AppPage" IsVisible="False" />
            </Grid>

            <!-- Statuszeile (gilt für alle Seiten) -->
            <Border Grid.Row="1" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="#30808080">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
