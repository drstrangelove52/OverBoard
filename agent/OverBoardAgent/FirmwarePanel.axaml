<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OverBoardAgent.FirmwarePanel">
    <StackPanel Spacing="6">
        <TextBlock x:Name="InstalledText" TextWrapping="Wrap" />
        <TextBlock x:Name="AvailableText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button x:Name="InstallButton" Classes="accent" />
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" IsVisible="False" Margin="0,6,0,0" />
        <TextBlock x:Name="LogText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
